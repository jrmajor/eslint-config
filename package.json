{
	"name": "@jrmajor/eslint-config",
	"version": "0.3.0",
	"license": "MIT",
	"author": "Jeremiasz Major <jrh.mjr@gmail.com>",
	"repository": "jrmajor/eslint-config",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"default": "./src/index.js",
			"types": "./src/types.d.ts"
		}
	},
	"scripts": {
		"check": "tsc",
		"check:watch": "tsc --watch",
		"lint": "eslint . --max-warnings 0",
		"inspect-config": "config-inspector --config testConfig.js"
	},
	"dependencies": {
		"@eslint/css": "^1.0",
		"@eslint/js": "^10.0",
		"@stylistic/eslint-plugin": "^5.10",
		"eslint-import-resolver-next": "^0.6.0",
		"eslint-plugin-import-x": "^4.16",
		"eslint-plugin-svelte": "^3.16",
		"tailwind-csstree": "^0.3.0",
		"typescript-eslint": "^8.59"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^1.5",
		"@types/node": "^24.12",
		"eslint": "^10.1",
		"globals": "*",
		"svelte": "*",
		"typescript": "^5.9"
	},
	"peerDependencies": {
		"eslint": ">= 10.1 < 11"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.33.0"
		}
	}
