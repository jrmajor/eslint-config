	"repository": "jrmajor/eslint-config",
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"default": "./src/index.js",
			"types": "./src/types.d.ts"
		}
	},
	"scripts": {
		"check": "tsc",
		"check:watch": "tsc --watch",
		"lint": "eslint . --max-warnings 0",
		"inspect-config": "eslint --inspect-config"
	},
	"dependencies": {
		"@eslint/js": "^9.24",
		"@stylistic/eslint-plugin": "^4.2",
		"eslint-import-resolver-next": "^0.5.0",
		"eslint-plugin-import-x": "^4.10.3",
		"eslint-plugin-svelte": "^3.1",
		"typescript-eslint": "^8.29"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^0.5.4",
		"@types/node": "^22.5",
		"eslint": "^9.24",
		"globals": "^15.9",
		"typescript": "^5.5"
	},
	"peerDependencies": {
		"eslint": ">= 9.24 < 10"
	},
	"peerDependenciesMeta": {
		"eslint-plugin-svelte": {
			"optional": true
		}
	},
	"volta": {
		"node": "22.16.0",
		"pnpm": "10.11.1"
	}
}
