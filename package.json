{
	"name": "@jrmajor/eslint-config",
	"version": "0.1.3",
	"license": "MIT",
	"author": "Jeremiasz Major <jrh.mjr@gmail.com>",
	"repository": "jrmajor/eslint-config",
	"type": "module",
	"packageManager": "pnpm@10.13.1",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"default": "./src/index.js",
			"types": "./src/types.d.ts"
		}
	},
	"scripts": {
		"check": "tsc",
		"check:watch": "tsc --watch",
		"lint": "eslint . --max-warnings 0",
		"inspect-config": "config-inspector --config testConfig.js"
	},
	"dependencies": {
		"@eslint/js": "^9.31",
		"@stylistic/eslint-plugin": "^5.2",
		"eslint-import-resolver-next": "^0.6.0",
		"eslint-plugin-import-x": "^4.16",
		"eslint-plugin-svelte": "^3.11",
		"typescript-eslint": "^8.37"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^1.1",
		"@types/node": "^22.16",
		"eslint": "^9.31",
		"globals": "^16.3",
		"svelte": "*",
		"typescript": "^5.8"
	},
	"peerDependencies": {
		"eslint": ">= 9.31 < 10"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.13.1"
		}
	}
}
