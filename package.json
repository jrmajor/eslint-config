{
	"name": "@jrmajor/eslint-config",
	"version": "0.1.3",
	"license": "MIT",
	"author": "Jeremiasz Major <jrh.mjr@gmail.com>",
	"repository": "jrmajor/eslint-config",
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"default": "./src/index.js",
			"types": "./src/types.d.ts"
		}
	},
	"scripts": {
		"check": "tsc",
		"check:watch": "tsc --watch",
		"lint": "eslint . --max-warnings 0",
		"inspect-config": "eslint --inspect-config"
	},
	"dependencies": {
		"@eslint/js": "^9.30",
		"@stylistic/eslint-plugin": "^4.4",
		"eslint-import-resolver-next": "^0.6.0",
		"eslint-plugin-import-x": "^4.16.1",
		"eslint-plugin-svelte": "^3.10",
		"typescript-eslint": "^8.35"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^0.5.4",
		"@types/node": "^22.15",
		"eslint": "^9.30",
		"globals": "^15.9",
		"typescript": "^5.8"
	},
	"peerDependencies": {
		"eslint": ">= 9.24 < 10"
	},
	"peerDependenciesMeta": {
		"eslint-plugin-svelte": {
			"optional": true
		}
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"volta": {
		"node": "22.16.0",
		"pnpm": "10.11.1"
	}
}
